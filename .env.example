# Environment Configuration Template for SMSGate CLI
# Copy this file to .env and fill in your actual values
# This file contains all required environment variables with examples and documentation

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API Endpoint URL
# Purpose: Base URL of the SMS Gateway API used by the smsgate CLI for all requests
# Format: URL
# Default: https://api.sms-gate.app/3rdparty/v1
# Example: https://api.sms-gate.app/3rdparty/v1
# Example: http://localhost:8080/3rdparty/v1
ASG_ENDPOINT=https://api.sms-gate.app/3rdparty/v1

# API Username
# Purpose: Username for authenticating with the SMS Gateway API
# Format: String
# Example: myuser
ASG_USERNAME=your-username

# API Password
# Purpose: Password for authenticating with the SMS Gateway API
# Format: String
# Example: mypassword
ASG_PASSWORD=your-password

# =============================================================================
# CERTIFICATE AUTHORITY CONFIGURATION
# =============================================================================

# CA Request Timeout
# Purpose: Timeout for requests made by the smsgate-ca CLI tool when issuing TLS certificates
# Format: Duration (e.g. 30s, 1m, 5m)
# Default: 30s
# Example: 30s
# Example: 1m
ASG_CA_TIMEOUT=30s
